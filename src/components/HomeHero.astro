<style>
	.hero {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -3em;
		padding: 4em 0 3em;
		background: rgba(var(--color-surface), 30%);
	}
	.hero-content {
		width: var(--page-width);
		max-width: calc(100% - 2em);
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 3em;
	}
	.profile-photo {
		border-radius: 50%;
		width: 200px;
		height: 200px;
		object-fit: cover;
		flex-shrink: 0;
	}
	.hero-text h1 {
		margin: 0 0 0.5em;
		font-size: 2.5em;
		line-height: 1.2;
	}
	.highlight {
		color: var(--color-accent);
	}
	.tagline {
		font-size: 1.2em;
		color: rgb(var(--color-text-secondary));
		margin: 0 0 0.3em;
		line-height: 1.5;
	}
	.subtitle {
		font-size: 1em;
		color: rgb(var(--color-text-secondary));
		margin: 0 0 1em;
		line-height: 1.5;
	}
	.social-links {
		display: flex;
		gap: 0.75em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--color-text-secondary));
	}
	.social-links a:hover {
		color: rgb(var(--color-text));
	}
	@media (max-width: 768px) {
		.hero {
			padding: 2em 0;
		}
		.hero-content {
			flex-direction: column;
			text-align: center;
			gap: 1.5em;
		}
		.profile-photo {
			width: 150px;
			height: 150px;
		}
		.hero-text h1 {
			font-size: 2em;
		}
	}
</style>
